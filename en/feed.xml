---
layout: null
permalink: /en/feed.xml
lang: en
sitemap: false
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
  <title type="html">{{ site.title }}</title>
  <subtitle>{{ site.description | strip_newlines }}</subtitle>
  <id>{{ '/en/feed.xml' | absolute_url }}</id>
  <link href="{{ '/en/feed.xml' | absolute_url }}" rel="self" type="application/atom+xml" />
  <link href="{{ '/en/' | absolute_url }}" rel="alternate" type="text/html" hreflang="en" />
  {%- assign posts = site.posts | where: "lang", "en" -%}
  <updated>{% if posts.first %}{{ posts.first.date | date_to_xmlschema }}{% else %}{{ site.time | date_to_xmlschema }}{% endif %}</updated>
  <author><name>{{ site.author.name }}</name></author>
  {%- for post in posts limit: 20 %}
  <entry>
    <title type="html">{{ post.title | xml_escape }}</title>
    <link href="{{ post.url | absolute_url }}" rel="alternate" type="text/html" />
    <id>{{ post.url | absolute_url }}</id>
    <published>{{ post.date | date_to_xmlschema }}</published>
    <updated>{{ post.date | date_to_xmlschema }}</updated>
    <summary type="html">{{ post.description | default: post.excerpt | strip_html | strip_newlines | truncate: 300 | xml_escape }}</summary>
    <content type="html" xml:base="{{ post.url | absolute_url }}">{{ post.content | strip | xml_escape }}</content>
  </entry>
  {%- endfor %}
</feed>
